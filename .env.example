# =========================================================================
# SYSTEM CONFIGURATION (.env)
# =========================================================================
APP_ENV=production
IS_SERVER=false
SERVER_IP=192.168.0.3

# --- GITHUB / GIT-SYNC CONFIGURATION ---
GIT_USERNAME=username
GIT_TOKEN=github_token

# --- POSTGRESQL DATABASE CONFIGURATION ---
DB_USER=admin
DB_PASSWORD=password
DB_NAME=sor_system
DB_PORT=5432

# --- BACKEND EXTERNAL CONFIGURATION ---
# Adres połączenia do bazy danych dla ORM (GORM) w kontenerze Go
DATABASE_URL=postgresql://admin:password@db:5432/sor_system

# Adres URL do mikrousługi AI dla żądań Triage
AI_SERVICE_URL=http://ai:8000/predict